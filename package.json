{
  "name": "varendor-ashen-frontier",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "verify:assets": "node scripts/verify-assets.mjs",
    "smoke": "node scripts/runtime-smoke.mjs",
    "build": "npm run typecheck && npm run verify:assets && vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@babylonjs/core": "8.26.1",
    "@babylonjs/loaders": "8.26.1"
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "vite": "7.1.3",
    "xhr2": "0.2.1"
  }
}
